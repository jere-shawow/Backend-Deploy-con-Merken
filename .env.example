# Copia este archivo como .env y completa los valores.
# .env NO se sube a git (está en .gitignore). En el EC2 va en ~/backend/.env

# ---------- MySQL (astronautas, settings, Garmin, notificaciones) ----------
DB_HOST=tu-servidor
DB_PORT=3306
DB_NAME=merken_db
DB_USER=tu-usuario
DB_PASSWORD=tu-clave

# ---------- DynamoDB (informes, base no relacional) ----------
# dynamodb = AWS (si no hay conexión guarda en local y lo avisa) | local = solo archivos
REPORTS_STORAGE=dynamodb
AWS_REGION=us-east-1
DYNAMODB_TABLE=astronaut-reports
DYNAMODB_CREATE_TABLE=true
# En el EC2 con ROL IAM deja estas dos vacías. En tu PC, las de un usuario IAM.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Opcionales ----------
# GARMIN_TIME_ZONE=America/Santiago
# NOTIFICATIONS_TIME_ZONE=America/Santiago
# REPORTS_TIME_ZONE=America/Santiago
